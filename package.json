{
  "name": "roomshift-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "preview": "node scripts/preview-built.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "laptop": "node scripts/start-local.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "install:ci": "node scripts/install-ci.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2",
    "zod": "^3.25.76",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.19.19",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
